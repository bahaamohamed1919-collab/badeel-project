// Entity-relationship diagram of the Badeel database (generated by erd.py)
digraph erd {
 graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.4, ranksep=0.7, pad=0.3, dpi=200];
 node [shape=plaintext, fontname="DejaVu Sans", fontsize=12];
 edge [color="#1b2540", fontname="DejaVu Sans", fontsize=10, arrowsize=0.9, dir=both];
 users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2540"><TR><TD COLSPAN="3" BGCOLOR="#1b2540"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">scrypt + salt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">patient | pharmacist | admin</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">active | pending | disabled</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="allergies_enc">allergies_enc</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">encrypted (Fernet)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="consent_at">consent_at</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">health-data consent</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="failed_logins">failed_logins</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="locked_until">locked_until</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR></TABLE>>];
 drugs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2540"><TR><TD COLSPAN="3" BGCOLOR="#1b2540"><FONT COLOR="white"><B>drugs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trade_name">trade_name</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trade_name_ar">trade_name_ar</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ingredients_display">ingredients_display</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="strength_display">strength_display</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="form">form</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">normalized</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="company">company</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price">price</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">REAL</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">&#8805; 0</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="drug_class">drug_class</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">indexed</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="availability">availability</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">available | shortage | unknown</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ingredient_key">ingredient_key</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">indexed</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="composition_key">composition_key</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">indexed with form</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="strength_known">strength_known</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">1 = matchable</FONT></TD></TR></TABLE>>];
 ingredients [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2540"><TR><TD COLSPAN="3" BGCOLOR="#1b2540"><FONT COLOR="white"><B>ingredients</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">UNIQUE</FONT></TD></TR></TABLE>>];
 drug_ingredients [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2540"><TR><TD COLSPAN="3" BGCOLOR="#1b2540"><FONT COLOR="white"><B>drug_ingredients</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="drug_id"><B>drug_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK, FK &#8594; drugs</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ingredient_id"><B>ingredient_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK, FK &#8594; ingredients</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="strength_value">strength_value</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">REAL</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="strength_unit">strength_unit</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="strength_text">strength_text</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR></TABLE>>];
 favorites [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2540"><TR><TD COLSPAN="3" BGCOLOR="#1b2540"><FONT COLOR="white"><B>favorites</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK, FK &#8594; users</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="drug_id"><B>drug_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK, FK &#8594; drugs</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR></TABLE>>];
 search_history [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2540"><TR><TD COLSPAN="3" BGCOLOR="#1b2540"><FONT COLOR="white"><B>search_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">FK &#8594; users</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="query">query</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR></TABLE>>];
 audit_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2540"><TR><TD COLSPAN="3" BGCOLOR="#1b2540"><FONT COLOR="white"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">FK &#8594; users (SET NULL)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="action">action</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detail">detail</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR></TABLE>>];
 security_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2540"><TR><TD COLSPAN="3" BGCOLOR="#1b2540"><FONT COLOR="white"><B>security_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="type">type</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">indexed</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ip">ip</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">indexed</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="path">path</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_agent">user_agent</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detail">detail</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR></TABLE>>];
 settings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1b2540"><TR><TD COLSPAN="3" BGCOLOR="#1b2540"><FONT COLOR="white"><B>settings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="key"><B>key</B></TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="value">value</TD><TD ALIGN="LEFT"><FONT COLOR="#566076">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#0b7a56"> </FONT></TD></TR></TABLE>>];
 users:id -> favorites:user_id [arrowtail=teetee, arrowhead=crowodot, label="saves"];
 drugs:id -> favorites:drug_id [arrowtail=teetee, arrowhead=crowodot];
 users:id -> search_history:user_id [arrowtail=teetee, arrowhead=crowodot, label="makes"];
 users:id -> audit_log:user_id [arrowtail=teeodot, arrowhead=crowodot, label="performs"];
 drugs:id -> drug_ingredients:drug_id [arrowtail=teetee, arrowhead=crowtee, label="contains (1..n)"];
 ingredients:id -> drug_ingredients:ingredient_id [arrowtail=teetee, arrowhead=crowodot, label="appears in"];
 {rank=same; users; drugs; ingredients}
 {rank=same; favorites; search_history; audit_log; drug_ingredients}
 {rank=same; security_events; settings}
 drug_ingredients -> security_events [style=invis];
}
