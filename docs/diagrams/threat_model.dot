// Data-flow diagram with trust boundaries, used for the STRIDE threat model
digraph threat_model {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.5, ranksep=0.9, pad=0.3, dpi=200, newrank=true,
         label="Threat model: data flows and trust boundaries (T1-T8 are listed in the threat table)", labelloc=t];
  node  [fontname="DejaVu Sans", fontsize=12, color="#1b2540", penwidth=1.3];
  edge  [fontname="DejaVu Sans", fontsize=10.5, color="#1b2540", arrowsize=0.8];

  subgraph cluster_internet { label="Untrusted: Internet"; style="dashed"; color="#a8322a"; penwidth=2; fontcolor="#a8322a";
    users [label="Patient /\nPharmacist /\nAdmin\n(browser)", shape=box];
    attacker [label="Attacker\n(person or\nautomated scanner)", shape=box, style=filled, fillcolor="#1b2540", fontcolor=white]; }

  subgraph cluster_server { label="Trusted: Badeel server"; style="dashed"; color="#0b7a56"; penwidth=2; fontcolor="#0b7a56";
    app [label="Badeel web\napplication\n(Flask)", shape=circle, width=1.6];
    subgraph cluster_storage { label="Storage boundary: instance/"; style="dotted"; color="#566076"; fontcolor="#566076";
      db  [label="D1  badeel.db\nusers, drugs, logs", shape=cylinder];
      key [label="D2  data.key,\nsession.key", shape=cylinder];
      mdl [label="D3  search_model.json", shape=cylinder]; } }

  csv [label="CSV file\n(admin upload)", shape=note];

  users -> app [label="T1 log in\nT3 forms (CSRF)\nT4 search text (SQLi, XSS)"];
  app -> users [label="pages, session cookie\nT5 data shown to wrong role"];
  attacker -> app [label="T1 password guessing\nT2 scanning for admin pages\nT6 fake pharmacist sign-up", color="#a8322a", fontcolor="#a8322a"];
  csv -> app [label="T7 malformed or\noversized file"];
  app -> db [label="parameterized SQL"];
  app -> key [label="read at start-up"];
  app -> mdl [label="read numbers only\n(no pickle)"];
  attacker -> db [label="T8 stolen database file", style=dashed, color="#a8322a", fontcolor="#a8322a"];
  {rank=same; users; attacker}
}
